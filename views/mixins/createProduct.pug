mixin createProduct(product)
    .col-md-4
        .card.mb-3
            img.card-img-top(src=`/img/${product.image}`, alt=product.name)
            .card-body
                h5.card-title
                    a(href=`/products/${product.id}`) #{product.name}
                small.text-muted
                    i.fas.fa-lira-sign #{product.price} TL

            .card-footer.text-center

                form(action='/cart', method='POST')
                    input(type='hidden', name='productId', value=`${product.id}`)
                    button(type='submit').btn.btn-sm.btn-outline-danger Add to Cart
                
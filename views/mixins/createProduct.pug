mixin createProduct(product)
    .col-md-4
        .card.mb-3
            a(href=`/products/${product._id}`)
                if product.imageUrl
                    img.card-img-top(src=product.imageUrl, alt=product.name)
                else
                    img.card-img-top(src="/img/no-image.png", alt="No Image")

            .card-body
                h5.card-title
                    a(href=`/products/${product._id}`) #{product.name}
                small.text-muted
                    i.fas.fa-lira-sign #{product.price} TL

            .card-footer.text-center

                form(action='/cart', method='POST')
                    input(type='hidden', name='productId', value=`${product._id}`)
                    input(type="hidden", name="_csrf", value=csrfToken)
                    button(type='submit').btn.btn-sm.btn-outline-danger Add to Cart
                
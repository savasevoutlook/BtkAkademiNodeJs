extends ../layouts/main-layout.pug

block styles
    link(rel="stylesheet", href="/css/forms.css")

block content
    .card.card-default 
        .card-header
            h6 Add Product
        .card-body
            if (errorMessage)
                .row
                    .col-12
                        .alert.alert-danger !{errorMessage}
            form(action="/admin/add-product", method="POST", enctype="multipart/form-data")
                input(type="hidden", name="_csrf", value=csrfToken)
                
                .form-group.row
                    label(for="name").col-2.col-form-label Prodcut Name
                    .col-10
                        input.form-control#name(type="text", name="name")
                .form-group.row
                    label(for="price").col-2.col-form-label Price
                    .col-10
                        input.form-control#price(type="text", name="price")
                .form-group.row
                    label(for="imageUrl").col-2.col-form-label Image
                    .col-10
                        input.form-control-file#imageUrl(type="file", name="imageUrl", accept="image/*")
                .form-group.row
                    label(for="description").col-2.col-form-label Description
                    .col-10
                        textarea.form-control#description(name="description", rows="5")
                if categories
                    .form-group.row
                        label(for="categoryIds").col-2.col-form-label Category
                        .col-10
                            each category in categories 
                                .form-group.form-check
                                    input.form-check-input(type="checkbox", name="categoryIds", id=`${category._id}`, value=`${category._id}`)
                                    label.form-check-label(for=`${category._id}`) #{category.name}
                .form-group.row
                    .col-2
                        label.form-check-label(for="isActive") Is Active
                    .col-10
                        .form-check
                            input.form-check-input#isActive(type="checkbox", name="isActive")
                .form-group.row
                    .col-10.offset-2
                        button.btn.btn-primary(type="submit") Save


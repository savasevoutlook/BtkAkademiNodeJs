block scripts
    script(src="https://cdn.ckeditor.com/ckeditor5/38.1.1/classic/ckeditor.js")
    script.
        ClassicEditor
            .create(document.querySelector('#description'))
            .then(editor => {
                const editable = editor.ui.view.editable.element;
                editable.style.minHeight = '150px';
                editable.style.height = '150px';
            })
            .catch(error => {
                console.error(error);
            });

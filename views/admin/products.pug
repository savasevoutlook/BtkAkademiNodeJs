extends ../layouts/main-layout.pug

block content
    if (action !== undefined)
        if (action === 'edit')
            div.alert.alert-success
                strong The product has been updated.
                button(type="button", data-dismiss="alert", aria-label="Close").close
                    span(aria-hidden="true") &#215;
        else if (action === 'delete')
            div.alert.alert-success
                strong The product has been deleted.
                button(type="button", data-dismiss="alert", aria-label="Close").close
                    span(aria-hidden="true") &#215;
    .row
        if (products && products.length > 0)
            .col-md-12
                h2 Product List
                table.table.table-striped.table-bordered
                    thead
                        tr
                            th(style='width: 80px;').text-center Image
                            th Name
                            th(style='width: 15%;').text-center Price
                            th Username
                            th(style="width: 15%;").text-center Actions
                    tbody
                        each product in products
                            tr
                                td.text-center
                                    if product.imageUrl
                                        img(src=product.imageUrl, alt=`${product.name}`, style='width: 70px;')
                                    else
                                        img(src="/img/no-image.png", alt="No Image", style='width: 70px;')

                                td #{product.name}
                                td.text-center #{product.price} TL
                                td #{product.userId.username}
                                td.text-center
                                    a.btn.btn-primary.btn-sm.mr-1(href=`/admin/edit-product/${product._id}`) Edit

                                    form(action='/admin/delete-product', method='post').d-inline
                                        input(type='hidden', name='productId', value=`${product._id}`)
                                        input(type="hidden", name="_csrf", value=csrfToken)
                                        
                                        button(type='submit').btn.btn-danger.btn-sm Delete
        else
            .col-md-12
                h2 No Products Available

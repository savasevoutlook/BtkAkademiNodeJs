extends ../layouts/main-layout.pug

block styles
    link(rel="stylesheet", href="/css/forms.css")

block content
    .card.card-default 
        .card-header
            h6 Edit Product
        .card-body
            form(action="/admin/edit-product", method="POST", enctype="multipart/form-data")
                input(type="hidden", name="id", value=`${product._id}`)#id
                input(type="hidden", name="_csrf", value=csrfToken)

                .form-group.row
                    label(for="name").col-2.col-form-label Prodcut Name
                    .col-10
                        input.form-control#name(type="text", name="name", value=`${product.name}`, required)
                .form-group.row
                    label(for="price").col-2.col-form-label Price
                    .col-10
                        input.form-control#price(type="text", name="price", value=`${product.price}`, required)
                .form-group.row
                    label(for="image").col-2.col-form-label Image
                    .col-10
                        input.form-control-file#image(type="file", name="image", accept="image/*", multiple, required)
                .form-group.row
                    label(for="description").col-2.col-form-label Description
                    .col-10
                        textarea.form-control#description(name="description", required) #{product.description}
                .form-group.row
                    label(for="categoryIds").col-2.col-form-label Category
                    .col-10
                        each category in categories 
                            .form-group.form-check
                                input.form-check-input(type="checkbox", name="categoryIds", id=`${category._id}`, value=`${category._id}`, checked=category.selected)
                                label.form-check-label(for=`${category._id}`) #{category.name}
                .form-group.row
                    label(for="isActive").col-2.col-form-label Is Active
                    .col-10
                        input.form-control#isActive(type="checkbox", name="isActive", checked=product.isActive)
                .form-group.row
                    .col-10.offset-2
                        button.btn.btn-primary(type="submit") Update

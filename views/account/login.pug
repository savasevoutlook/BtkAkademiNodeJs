extends ../layouts/main-layout.pug

block styles
    link(rel="stylesheet", href="/css/forms.css")

block content
    .row.mt-5
        .col-6.offset-3
            .card.card-default 
                .card-header
                    h6 Login
                .card-body
                    form(action="/login", method="POST")
                        input(type="hidden", name="_csrf", value=csrfToken)
                        
                        if errorMessage
                            .alert.alert-danger #{errorMessage}

                        .form-group.row
                            label(for="email").col-3.col-form-label Email
                            .col-9
                                input.form-control#email(type="text", name="email", required)
                        .form-group.row
                            label(for="password").col-3.col-form-label Password
                            .col-9
                                input.form-control#password(type="password", name="password", required)
                        .form-group.row
                            .col-4.offset-3
                                button.btn.btn-primary(type="submit") Login
                            .col-5.text-right
                                a(href="/reset-password").btn.btn-link Forgot Password?

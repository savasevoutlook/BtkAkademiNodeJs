extends ../layouts/main-layout.pug

block styles
    style.
        #productCarousel {
            height: 500px;
        }

        #productCarousel .carousel-item img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        #productCarousel .carousel-control-prev-icon,
        #productCarousel .carousel-control-next-icon {
            background-color: rgba(0,0,0,0.4);
            border-radius: 50%;
            width: 3rem;
            height: 3rem;
        }

block content
    .row
        .col-md-6
            .border.rounded.p-2.shadow-sm
                if product.imageUrls && product.imageUrls.length > 0
                    #productCarousel.carousel.slide.carousel-fade(data-ride="carousel")
                        .carousel-inner
                            each img, i in product.imageUrls
                                .carousel-item(class=i === 0 ? "active" : "")
                                    img.d-block.w-100.rounded(src=`/${img}`, alt=`${product.name} - ${i+1}`)
                        
                        button.carousel-control-prev(type="button", data-target="#productCarousel", data-slide="prev")
                            span.carousel-control-prev-icon(aria-hidden="true")
                            span.sr-only Previous
                        button.carousel-control-next(type="button", data-target="#productCarousel", data-slide="next")
                            span.carousel-control-next-icon(aria-hidden="true")
                            span.sr-only Next
                else
                    img(src="/img/no-image.png", alt="No Image").img-fluid.rounded

        .col-md-6.pl-4
            h5 #{product.name}
            hr
            p #{product.description}
            p #{product.price} TL

            form(action='/cart', method='POST')
                input(type='hidden', name='productId', value=`${product._id}`)
                input(type="hidden", name="_csrf", value=csrfToken)
                button(type='submit').btn.btn-outline-danger
                    i.fa.fa-shopping-cart  Add to Cart

extends ../layouts/main-layout.pug

block content
    .row 
        .col-md-4.border.border-secondary
            img(src=`/img/${product.image}`, alt=`${product.name}`).img-fluid
        .col-md-8.pl-4
            h5 #{product.name}
            hr
            p #{product.description}
            p #{product.price} TL

            form(action='/cart', method='POST')
                input(type='hidden', name='productId', value=`${product.id}`)
                button(type='submit').btn.btn-outline-danger
                    i.fa.fa-shopping-cart  Add to Cart

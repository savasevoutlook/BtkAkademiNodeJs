extends ../layouts/main-layout.pug

block content
    if orders.length > 0
        .accordion#accordionOrders
            each order, index in orders
                .card.mb-2
                    .card-header(id=`heading${index}`)
                        h2.mb-0
                            button.btn.btn-link.btn-block.text-left(type="button", data-toggle="collapse", data-target=`#collapse${index}`, aria-expanded=(index == 0 ? "true" : "false"), aria-controls=`collapse${index}`)
                                | Order Id: #{order._id}

                    .collapse(id=`collapse${index}`, class=(index == 0 ? "show" : ""), aria-labelledby=`heading${index}`, data-parent="#accordionOrders")
                        .card-body
                            table.table.table-sm.table-bordered
                                thead.thead-dark
                                    tr 
                                        th.text-center Image 
                                        th Product Name
                                        th.text-center Price
                                        th.text-center Quantity 
                                tbody
                                    each item in order.items 
                                        tr 
                                            td.text-center.align-middle
                                                if item.product.imageUrls && item.product.imageUrls.length > 0
                                                    img(src=`/${item.product.imageUrls[0]}`, alt=`${item.product.name}`, style='width: 80px;')
                                                else 
                                                    img(src="/img/no-image.png", alt="No Image", style='width: 80px;')
                                            td.align-middle #{item.product.name}
                                            td.text-center.align-middle #{parseFloat(item.product.price).toFixed(2)} TL
                                            td.text-center.align-middle #{item.quantity}

                                - var total = 0;
                                each item in order.items
                                    - total += (item.product.price * item.quantity)
                                tfoot
                                    tr 
                                        td
                                        td(colspan="1").align-middle Sipariş Tarihi: 
                                            strong #{order.date.toLocaleString("tr-TR")}
                                        td.text-center.align-middle Toplam:
                                            br
                                            span #{total.toFixed(2)} TL
                                        td
    else 
        h1 No Orders

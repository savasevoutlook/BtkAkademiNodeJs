extends ../layouts/main-layout.pug

block content
    
    if products.length > 0
        table.table.table-bordered 
            thead
                tr
                    th(style="width: 100px").text-center Image 
                    th Product Name 
                    th(style="width: 150px").text-center Price 
                    th(style="width: 120px").text-center Quantity
                    th.text-center Actions
            tbody
                each product in products 
                    tr 
                        td.text-center.align-middle
                            img(src=`/img/${product.image}`, alt=`${product.name}`, style='width: 100px;')
                        td.align-middle #{product.name}
                        td.text-center.align-middle #{product.price} TL
                        td.text-center.align-middle #{product.cartItem.quantity}
                        td.text-center.align-middle
                            form(action='/delete-cartitem', method='post')
                                input(type='hidden', name='productId', value=`${product.id}`)
                                button(type='submit').btn.btn-outline-danger.btn-sm
                                    i.fa.fa-times
    else
        .col-md-12
            h2 No Products Available
